# Copy this file to ".env" and fill in the values. Never upload ".env" to GitHub.

# development | production
NODE_ENV=development

# Port for local development (Render sets PORT by itself)
PORT=5000

# PostgreSQL connection string (for example from Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# A long random secret used to sign the login tokens (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# How long a login token is valid
JWT_EXPIRES_IN=2h

# Allowed client addresses, separated by commas
CORS_ORIGIN=http://localhost:5173

# Demo data: when "true", demo users and groups are created on server start (only if missing)
SEED_DEMO_DATA=false
# The password of the demo users - choose one yourself (at least 6 characters).
# Without it no demo data is created.
SEED_DEMO_PASSWORD=

# Database for the automated tests (npm test). The tests DELETE all rows before every test,
# so this address must contain the word "test". The easiest way: the same address as
# DATABASE_URL with "?schema=sharefund_test" at the end - the tests then get their own
# separate set of tables and never touch the real data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=sharefund_test
